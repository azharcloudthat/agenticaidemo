name: CI

# Turns the success criteria for agent pull requests into enforceable checks:
# unit tests must pass and CodeQL analysis must complete.
# Mark both jobs ("test" and "security-analysis") as required status checks
# in a ruleset or branch protection rule for main.

on:
  pull_request:
    branches: [ main ]

# Least privilege default. Jobs raise it only where needed.
permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"   # matches the runtime in the README deploy steps
          cache: pip

      - name: Install dependencies
        run: pip install -r requirements.txt pytest

      - name: Run unit tests
        run: python -m pytest -q

  security-analysis:
    runs-on: ubuntu-latest
    permissions:
      actions: read
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@v4

      - name: Initialize analysis
        uses: github/codeql-action/init@v3
        with:
          languages: python

      - name: Analyze
        uses: github/codeql-action/analyze@v3